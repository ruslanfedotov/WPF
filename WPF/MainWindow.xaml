<Window x:Class="WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button x:Name="btnProducts" Margin="50" Width="100" Click="btnProducts_Click">Товары</Button>
            <Button x:Name="btnCart" Margin="50" Width="100" Click="btnCart_Click">Корзина</Button>
            <Button x:Name="btnOrders" Margin="50" Width="100" Click="btnOrders_Click">Заказы</Button>
        </StackPanel>

        <Frame x:Name="MainFrame" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
